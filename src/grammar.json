{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "devnotes",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "note_block"
      }
    },
    "note_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header_line"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "directive_line"
          }
        },
        {
          "type": "SYMBOL",
          "name": "separator_line"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "body_line"
          }
        }
      ]
    },
    "header_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@note"
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "SYMBOL",
          "name": "id"
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "SYMBOL",
          "name": "category"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_ws"
              },
              {
                "type": "SYMBOL",
                "name": "header_field"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "SYMBOL",
          "name": "title"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "id": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[A-Za-z0-9_-]+"
      }
    },
    "category": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z][A-Za-z0-9_-]*"
      }
    },
    "header_field": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "status"
        },
        {
          "type": "SYMBOL",
          "name": "priority"
        },
        {
          "type": "SYMBOL",
          "name": "timestamp"
        },
        {
          "type": "SYMBOL",
          "name": "tags"
        },
        {
          "type": "SYMBOL",
          "name": "extension_field"
        }
      ]
    },
    "status": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "open"
            },
            {
              "type": "STRING",
              "value": "resolved"
            },
            {
              "type": "STRING",
              "value": "wontfix"
            },
            {
              "type": "STRING",
              "value": "deprecated"
            }
          ]
        }
      }
    },
    "priority": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "P0"
            },
            {
              "type": "STRING",
              "value": "P1"
            },
            {
              "type": "STRING",
              "value": "P2"
            },
            {
              "type": "STRING",
              "value": "P3"
            }
          ]
        }
      }
    },
    "timestamp": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?([+-][0-9]{2}:[0-9]{2}|Z)?)?"
      }
    },
    "tags": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_ws"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "SYMBOL",
                "name": "tag_name"
              }
            ]
          }
        }
      ]
    },
    "tag_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z0-9_-]+"
      }
    },
    "extension_field": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z][A-Za-z0-9_-]*"
      }
    },
    "title": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "directive_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "author_directive"
        },
        {
          "type": "SYMBOL",
          "name": "see_directive"
        },
        {
          "type": "SYMBOL",
          "name": "extension_directive"
        }
      ]
    },
    "author_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "STRING",
              "value": "author"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "SYMBOL",
          "name": "author_value"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "author_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "see_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "STRING",
              "value": "see"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_ws"
        },
        {
          "type": "SYMBOL",
          "name": "reference"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "reference": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "id"
        },
        {
          "type": "SYMBOL",
          "name": "url"
        },
        {
          "type": "SYMBOL",
          "name": "reference_value"
        }
      ]
    },
    "url": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n\\t ]+"
        }
      }
    },
    "reference_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "extension_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "SYMBOL",
          "name": "directive_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_ws"
                },
                {
                  "type": "SYMBOL",
                  "name": "directive_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "directive_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z0-9_-]+"
      }
    },
    "directive_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "separator_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_ws"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "body_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "body_text"
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "TOKEN",
              "content": {
                "type": "STRING",
                "value": "@note"
              }
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "body_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^@\\r\\n][^\\r\\n]*"
            },
            {
              "type": "PATTERN",
              "value": "@(?:[^n\\r\\n]|n[^o\\r\\n]|no[^t\\r\\n]|not[^e\\r\\n]|note[^ \\t\\r\\n])[^\\r\\n]*"
            },
            {
              "type": "PATTERN",
              "value": "[\\t ]+"
            }
          ]
        }
      }
    },
    "_ws": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_newline": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\r"
              },
              {
                "type": "STRING",
                "value": "\n"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    }
  },
  "extras": [],
  "conflicts": [
    [
      "note_block"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}